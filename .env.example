# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it, never paste its contents into a chat, an issue, a PR.

PRE_USERNAME=
PRE_PASSWORD=
PRE_EAN=

# Alternative to USERNAME/PASSWORD: a session cookie copied from a live
# browser login (DevTools -> Application -> Cookies -> www.predistribuce.cz
# -> PHPSESSID). Only needed if login() itself gets blocked.
# PRE_COOKIE_NAME=PHPSESSID
# PRE_COOKIE_VALUE=
